+def _bounded_has_nan(value, max_elements=1048576):
+    """Equivalent to isnan(value).any(), with bounded temporary storage."""
+    if value.numel() <= max_elements:
+        return bool(torch.isnan(value).any())
+    axis = max(range(value.ndim), key=lambda i: value.shape[i])
+    width = max(1, value.shape[axis] // 2)
+    return any(_bounded_has_nan(part, max_elements) for part in value.split(width, dim=axis))
